<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/calculatorContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_calculator"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0"
            android:textColor="@color/display_text"
            android:textSize="42sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="start"
            android:paddingTop="24dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text=""
            android:textColor="@color/display_subtext"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="start"
            android:paddingBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAc"
                    style="@style/CalcButtonLight"
                    android:text="@string/ac_label" />

                <Button
                    android:id="@+id/btnOpenClose"
                    style="@style/CalcButtonOperator"
                    android:text="@string/brackets_label" />

                <Button
                    android:id="@+id/btnPercent"
                    style="@style/CalcButtonOperator"
                    android:text="@string/percent_label" />

                <Button
                    android:id="@+id/btnDivide"
                    style="@style/CalcButtonOperator"
                    android:text="@string/divide_label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn7"
                    style="@style/CalcButtonNumber"
                    android:text="7" />

                <Button
                    android:id="@+id/btn8"
                    style="@style/CalcButtonNumber"
                    android:text="8" />

                <Button
                    android:id="@+id/btn9"
                    style="@style/CalcButtonNumber"
                    android:text="9" />

                <Button
                    android:id="@+id/btnMultiply"
                    style="@style/CalcButtonOperator"
                    android:text="@string/multiply_label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn4"
                    style="@style/CalcButtonNumber"
                    android:text="4" />

                <Button
                    android:id="@+id/btn5"
                    style="@style/CalcButtonNumber"
                    android:text="5" />

                <Button
                    android:id="@+id/btn6"
                    style="@style/CalcButtonNumber"
                    android:text="6" />

                <Button
                    android:id="@+id/btnMinus"
                    style="@style/CalcButtonOperator"
                    android:text="-" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn1"
                    style="@style/CalcButtonNumber"
                    android:text="1" />

                <Button
                    android:id="@+id/btn2"
                    style="@style/CalcButtonNumber"
                    android:text="2" />

                <Button
                    android:id="@+id/btn3"
                    style="@style/CalcButtonNumber"
                    android:text="3" />

                <Button
                    android:id="@+id/btnPlus"
                    style="@style/CalcButtonOperator"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn0"
                    style="@style/CalcButtonNumber"
                    android:text="0" />

                <Button
                    android:id="@+id/btnDot"
                    style="@style/CalcButtonNumber"
                    android:text="." />

                <Button
                    android:id="@+id/btnBackspace"
                    style="@style/CalcButtonNumber"
                    android:text="@string/backspace_label" />

                <Button
                    android:id="@+id/btnEquals"
                    style="@style/CalcButtonEqual"
                    android:text="=" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>